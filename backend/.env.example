# =====================================================
# 途吖后端 - 环境变量模板（提交到 git）
# 复制为 .env 后填实际值
# =====================================================

# ---------- 应用 ----------
APP_NAME=途吖后端
# production（生产）/ development（开发）。生产必须 production：
# 1) 会强制 ENABLE_MOCK_MODE=false（若为 true 直接启动报错）
# 2) 关闭调试回显、校验密钥强度等
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- 数据库 ----------
# ⚠️ 生产必须用 PostgreSQL（异步 asyncpg + 同步 psycopg 用于 Alembic）
#   DATABASE_URL=postgresql+asyncpg://<user>:<pass>@<host>:5432/<db>
#   DATABASE_URL_SYNC=postgresql://<user>:<pass>@<host>:5432/<db>
# 下面给出可直接替换的占位（部署时改成你的真实实例，切勿用 localhost）
DATABASE_URL=postgresql+asyncpg://travelphoto:CHANGE_ME@db.example.com:5432/travelphoto
DATABASE_URL_SYNC=postgresql://travelphoto:CHANGE_ME@db.example.com:5432/travelphoto
# 仅本地开发可用 SQLite（注意：SQLite 不支持部分时区/并发特性，仅用于快速联调）
#   DATABASE_URL=sqlite+aiosqlite:///./travel_photo.db
#   DATABASE_URL_SYNC=sqlite:///./travel_photo.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# ---------- 微信小程序 ----------
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MCHID=
WECHAT_PAY_KEY=
WECHAT_PAY_CERT_PATH=
WECHAT_PAY_KEY_PATH=

# ---------- JWT（生产必填，且至少 32 字符）----------
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---------- 对象存储 ----------
OSS_TYPE=oss
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET=travelphoto-dev
OSS_REGION=cn-hangzhou
OSS_STS_DURATION_SECONDS=3600

# ---------- 大模型 ----------
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-vl-plus
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30

# ---------- 精修服务 ----------
RETOUCH_PROVIDER=meitu
RETOUCH_API_URL=
RETOUCH_API_KEY=

# ---------- 监控 ----------
SENTRY_DSN=

# ---------- 业务开关 ----------
# ⚠️ 生产必须 false。true 时所有微信登录/支付/AI 流水线走 mock 假数据。
# 注意：APP_ENV=production 时若此值为 true，后端启动会直接抛错（见 config.py）。
ENABLE_MOCK_MODE=false
VIP_DEFAULT_DURATION_DAYS=30
