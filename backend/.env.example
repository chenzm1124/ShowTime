# =====================================================
# 途吖后端 - 环境变量模板（提交到 git）
# 复制为 .env 后填实际值
# =====================================================

# ---------- 应用 ----------
APP_NAME=途吖后端
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- 数据库 ----------
# 开发用 SQLite：
#   DATABASE_URL=sqlite+aiosqlite:///./travel_photo.db
#   DATABASE_URL_SYNC=sqlite:///./travel_photo.db
# 生产用 PostgreSQL：
#   DATABASE_URL=postgresql+asyncpg://travelphoto:travelphoto@localhost:5432/travelphoto
#   DATABASE_URL_SYNC=postgresql://travelphoto:travelphoto@localhost:5432/travelphoto
DATABASE_URL=sqlite+aiosqlite:///./travel_photo.db
DATABASE_URL_SYNC=sqlite:///./travel_photo.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# ---------- 微信小程序 ----------
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MCHID=
WECHAT_PAY_KEY=
WECHAT_PAY_CERT_PATH=
WECHAT_PAY_KEY_PATH=

# ---------- JWT（生产必填，且至少 32 字符）----------
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---------- 对象存储 ----------
OSS_TYPE=oss
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET=travelphoto-dev
OSS_REGION=cn-hangzhou
OSS_STS_DURATION_SECONDS=3600

# ---------- 大模型 ----------
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-vl-plus
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30

# ---------- 精修服务 ----------
RETOUCH_PROVIDER=meitu
RETOUCH_API_URL=
RETOUCH_API_KEY=

# ---------- 监控 ----------
SENTRY_DSN=

# ---------- 业务开关 ----------
ENABLE_MOCK_MODE=true
VIP_DEFAULT_DURATION_DAYS=30
